# 代理（cliproxy）提取接口 key — 从 cliproxy 控制台获取，切勿提交真实值
PROXY_API_KEY=your_cliproxy_key_here
# 采集节奏：每请求随机间隔（秒）
PACE_MIN=3
PACE_MAX=7
# lane 数（= 同时使用的 IP 数；每 lane 串行）。测试期建议 1
LANES=1
# 自动换IP：false=封控停下报警，网页手动换；true=封控自动换
AUTO_ROTATE=false
# 单 IP 安全上限（分钟，留余量防 cliproxy 端 12h 掐线）
IP_MAX_AGE_MIN=690
# API Key（请求头 X-API-Key）— 生产环境务必改为随机强密码
API_KEY=change-me-please
# 服务端口
PORT=3000
# SQLite 路径
DB_PATH=data/walmart.db
# 详情并发线程数（>1 并发采详情+失败率自适应限流；1=串行。单粘性IP建议3-5）
DETAIL_WORKERS=4
# 卖家后台 isbm 会话落盘路径（由本地 upload_session.py 上报写入；缺则后台GTIN开关优雅跳过）
SELLER_SESSION_FILE=data/seller_session.json
# BitBrowser Local API Token —— 仅【本地】跑 upload_session.py 提取会话时需要；
# 服务器端不需要（服务器只用会话文件，不连 BitBrowser）。切勿提交真实值。
BIT_API_KEY=your_bitbrowser_local_api_token
