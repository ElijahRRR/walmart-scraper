# systemd unit 示例：沃尔玛采集服务
# 用法：
#   1. 按实际情况修改 User/WorkingDirectory/ExecStart
#   2. sudo cp deploy/walmart-scraper.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now walmart-scraper
#   5. sudo systemctl status walmart-scraper
#   6. journalctl -u walmart-scraper -f    （查看实时日志）

[Unit]
Description=Walmart Product Scraper Service
After=network.target

[Service]
Type=simple
# 运行用户（不要用 root；按实际部署环境修改）
User=walmart
Group=walmart

# 项目根目录（按实际路径修改）
WorkingDirectory=/opt/walmart-scraper

# 使用虚拟环境中的 Python 启动服务
# 如果没有 venv，改为系统 python3
ExecStart=/opt/walmart-scraper/.venv/bin/python3 run_server.py

# 退出后自动重启（最多 3 次，间隔 10s；超限则 failed）
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=60

# 环境变量文件（生产环境把 .env 放这里，不要提交到 git）
EnvironmentFile=-/opt/walmart-scraper/.env

# 标准输出/错误写入 journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=walmart-scraper

# 优雅关闭等待时间（uvicorn graceful shutdown）
TimeoutStopSec=30

# 安全加固（可选，按需开启）
# NoNewPrivileges=true
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/opt/walmart-scraper/data

[Install]
WantedBy=multi-user.target
